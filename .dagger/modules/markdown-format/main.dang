"""Format every Markdown file in the workspace with a pinned Prettier."""
type MarkdownFormat {
  """
  Markdown files in the workspace.
  """
  pub source: Directory!

  """
  Node base image, pinned by tag and digest.
  """
  pub baseImage: String! = "node:22.14.0-alpine3.21@sha256:9bef0ef1e268f60627da9ba7d7605e8831d5b56ad07487d24d1aa386336d1944"

  """
  Prettier version, an exact release.
  """
  pub prettierVersion: String! = "3.10.1"

  new(
    ws: Workspace!,
    baseImage: String! = "node:22.14.0-alpine3.21@sha256:9bef0ef1e268f60627da9ba7d7605e8831d5b56ad07487d24d1aa386336d1944",
    prettierVersion: String! = "3.10.1",
  ) {
    self.source = ws.directory("/", include: ["**/*.md"], exclude: [".git", "**/node_modules"])
    self.baseImage = baseImage
    self.prettierVersion = prettierVersion
    self
  }

  let prettier: Container! {
    container
      .from(baseImage)
      .withExec(["npm", "install", "--global", "--ignore-scripts", "prettier@" + prettierVersion])
  }

  """
  Rewrite every Markdown file to the formatted output. The generator's staleness check fails when any file differs.
  """
  pub format: Changeset! @generate {
    let formatted = prettier
      .withDirectory("/src", source)
      .withWorkdir("/src")
      .withExec(["prettier", "--write", "--embedded-language-formatting", "off", "**/*.md"])
      .directory("/src")
    formatted.changes(source)
  }
}
